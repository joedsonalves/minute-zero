# Your Mobula key: https://admin.mobula.io
# The free plan gives 10,000 credits/month, no card required.
MOBULA_API_KEY=

# Daily credit ceiling for this instance. It exists so the public demo cannot
# burn the month's quota in an afternoon - and so you see "out of quota"
# instead of a 429 you might read as "this token has no data".
MOBULA_DAILY_BUDGET=400
